{
  "name": "@bizmyth/pi-address-review-comments",
  "version": "0.3.0",
  "description": "A supervised GitHub PR review-comment workflow for the Pi coding agent",
  "type": "module",
  "license": "MIT",
  "author": "Drew Council",
  "packageManager": "bun@1.3.13",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent"
  ],
  "files": [
    "src",
    "mock",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "biome ci . && tsc -p tsconfig.json && bun test",
    "check:fix": "biome check --write --unsafe . && tsc -p tsconfig.json && bun test",
    "mock": "bun mock/run.ts",
    "test": "bun test",
    "prepublishOnly": "bun run check && npm pack --dry-run"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@earendil-works/pi-ai": "0.86.1",
    "@earendil-works/pi-coding-agent": "0.86.0",
    "@earendil-works/pi-tui": "0.86.1",
    "@types/bun": "^1.4.2",
    "typebox": "1.3.27",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drew-council/pi-address-review-comments.git"
  },
  "bugs": {
    "url": "https://github.com/drew-council/pi-address-review-comments/issues"
  },
  "homepage": "https://github.com/drew-council/pi-address-review-comments#readme"
}
